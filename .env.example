# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Server only. Copy this file to .env for npm run dev:api / npm start.
# Use Application Default Credentials or a service account outside this repository.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json
# Defaults for project/database are read from firebase-applet-config.json.
# GCLOUD_PROJECT=your-project-id
# FIRESTORE_DATABASE_ID=your-database-id
PORT=3001
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Set a supported Graph API version from your Meta app, such as v25.0.
WHATSAPP_GRAPH_VERSION=""

# Public business phone (digits including country code), NOT the phone number ID.
# Optional: shows the producer registration link on the landing page.
VITE_WHATSAPP_NUMBER=""
